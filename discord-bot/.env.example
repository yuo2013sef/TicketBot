# ==============================
# إعدادات البوت - أسرار مطلوبة
# ==============================

# رمز البوت (Token) من Discord Developer Portal
DISCORD_TOKEN=your_bot_token_here

# معرّف التطبيق (Client ID / Application ID)
DISCORD_CLIENT_ID=your_client_id_here

# معرّف السيرفر (اختياري - للتسجيل السريع أثناء الاختبار)
# إذا تركته فارغاً، سيتم نشر الأوامر عالمياً (قد يستغرق حتى ساعة)
DISCORD_GUILD_ID=your_guild_id_here
